#T 20 0 639760 1 
#T 10 0 689699 1 
#T 50 0 739638 1 
#T 13 0 789577 1 
#T 13 0 798674 798682 798674 798682 1 
#T 155 0 889446 1 
#T 10 0 939385 1 
#T 22 0 989324 1 
#T 18 0 1039263 1 
#T 34 0 1050618 1050622 1051016 1051017 1054317 1054327 1057048 1057075 1057251 1058472 1058483 1066657 1066731 1070723 1070725 1076055 1076069 1076071 1076345 1076055 1076069 1076071 1076450 1076345 1076055 1076069 1076055 1076069 1076071 1 
